@startuml sequence-invitation
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName Helvetica

title Diagramme de séquence — Inviter un utilisateur

actor Organisateur
participant ":ControleurEvenement" as IHM
participant ":Client" as C
participant ":GestionnaireClient" as GC
participant ":ServiceEvenements" as S
participant "e:Evenement" as E
participant ":DepotSQLite" as D

Organisateur -> IHM : clique sur « Inviter » (login)
IHM -> C : envoyer(Requete INVITER)
note right of IHM : dans une Task JavaFX
C -> GC : writeObject(requete) via Socket
GC -> S : inviter(utilisateurConnecte, idEvt, login)
S -> D : trouverEvenement(idEvt)
D --> S : e
S -> S : verifierOrganisateur(u, e)
alt l'utilisateur n'est pas l'organisateur
  S --> GC : AccesRefuseException
  GC --> C : Reponse(succes=false, "Accès refusé")
else organisateur valide
  S -> D : trouverUtilisateur(login)
  D --> S : invite
  S -> E : inviter(invite)
  E --> S : invitation (EN_ATTENTE)
  S -> D : enregistrerInvitation(idEvt, invitation)
  note right of D : INSERT INTO invitation (JDBC)
  S --> GC : invitation
  GC --> C : Reponse(succes=true, invitation)
end
C --> IHM : reponse
IHM --> Organisateur : affiche le résultat (Platform.runLater)
@enduml
