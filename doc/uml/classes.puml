@startuml classes
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName Helvetica
skinparam classAttributeIconSize 0

title Diagramme de classes — Modèle métier

class Evenement {
  -id: int
  -nom: String
  -lieu: String
  -prix: double
  -logo: byte[]
  -banniere: byte[]
  -description: String
  -dateEvenement: LocalDateTime
  -capaciteMax: int
  -type: TypeEvenement
  +inviter(appelant: Personne, p: Personne): Invitation
  +ajouterOrganisateur(appelant: Personne, p: Personne): void
  +estOrganisateur(p: Personne): boolean
  +estParticipant(p: Personne): boolean
  +ajouterBesoin(b: Besoin): void
  +supprimerBesoin(b: Besoin): void
  +envoyerMessage(m: Message): void
  +getParticipants(): List<Personne>
  +estComplet(): boolean
  +besoinsSuggeres(): List<Besoin>
  +calculerBudget(): double
}

enum TypeEvenement {
  ANNIVERSAIRE
  MARIAGE
  SOIREE
  AUTRE
}

class Message {
  -id: int
  -contenu: String
  -date: LocalDateTime
  +getContenu(): String
  +afficher(): String
}

class Invitation {
  -id: int
  -statut: StatutInvitation
  -dateInvitation: LocalDateTime
  +accepter(): void
  +refuser(): void
  +estAcceptee(): boolean
}

enum StatutInvitation {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
}

abstract class Besoin {
  -id: int
  -nom: String
  -prix: double
  -quantite: int
  +attribuerA(p: Personne): void
  +liberer(): void
  +aUnAcheteur(): boolean
  +calculerCout(): double
  +{abstract} getCategorie(): String
  +{abstract} decrire(): String
}

class Consommable {
  -unite: String
  -perissable: boolean
  +getCategorie(): String
  +decrire(): String
}

abstract class Materiel {
  -aRendre: boolean
  -etat: String
  +getCategorie(): String
}

class MateriauSon {
  -puissanceWatts: int
  +decrire(): String
}

class Lumiere {
  -couleur: String
  +decrire(): String
}

class Personne {
  -id: int
  -nom: String
  -prenom: String
  -telephone: String
  -avatar: byte[]
  -email: String
  -mdpHash: String
  -dateNaissance: LocalDate
  +verifierMotDePasse(mdp: String): boolean
  +getNomComplet(): String
  +getAge(): int
}

Evenement "*" o-- "1..*" Personne : organisateurs
Evenement "1" *-- "*" Invitation : invitations
Evenement "1" *-- "*" Besoin : besoins
Evenement "1" *-- "*" Message : messages

Message "*" --> "1" Personne : envoyeur
Message "*" --> "1" Personne : receveur
Invitation "*" --> "1" Personne : invite
Besoin "*" --> "0..1" Personne : acheteur

Besoin <|-- Consommable
Besoin <|-- Materiel
Materiel <|-- MateriauSon
Materiel <|-- Lumiere

note right of Evenement
  **inviter()** : ne fonctionne que
  si l'appelant est un organisateur
  et si la personne n'est pas déjà invitée.
  **besoinsSuggeres()** : si type = MARIAGE,
  un budget traiteur (Consommable)
  est proposé à la création.
end note

note "acheteur = null →\nà la charge des organisateurs" as N2
Besoin .. N2

@enduml
