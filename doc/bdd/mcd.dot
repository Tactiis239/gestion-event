// MCD (Merise) de la gestion d'événements, déduit du diagramme de classes.
// Régénérer l'image depuis la racine du projet : dot -Tpng -Gdpi=110 doc/bdd/mcd.dot -o doc/bdd/mcd.png
graph MCD {
    graph [layout=neato, overlap=false, splines=true, sep="+20", fontname="Helvetica", pad=0.5,
           label="MCD — Gestion d'événements", labelloc=t, fontsize=18];
    node  [fontname="Helvetica", fontsize=11];
    edge  [fontname="Helvetica", fontsize=10];

    // ---------------------------------------------------------------- entités
    node [shape=plain];
    PERSONNE [pos="0,4!", label=<
      <table border="1" cellborder="0" cellspacing="0" cellpadding="4">
        <tr><td bgcolor="#dddddd"><b>PERSONNE</b></td></tr>
        <tr><td align="left"><u>id_personne</u><br align="left"/>nom<br align="left"/>prenom<br align="left"/>telephone<br align="left"/>email<br align="left"/>mdp_hash<br align="left"/>date_naissance<br align="left"/></td></tr>
      </table>>];
    EVENEMENT [pos="8,4!", label=<
      <table border="1" cellborder="0" cellspacing="0" cellpadding="4">
        <tr><td bgcolor="#dddddd"><b>EVENEMENT</b></td></tr>
        <tr><td align="left"><u>id_evenement</u><br align="left"/>nom<br align="left"/>lieu<br align="left"/>prix<br align="left"/>banniere<br align="left"/>description<br align="left"/>date_evenement<br align="left"/>type<br align="left"/></td></tr>
      </table>>];
    MESSAGE [pos="4,8!", label=<
      <table border="1" cellborder="0" cellspacing="0" cellpadding="4">
        <tr><td bgcolor="#dddddd"><b>MESSAGE</b></td></tr>
        <tr><td align="left"><u>id_message</u><br align="left"/>contenu<br align="left"/>date<br align="left"/></td></tr>
      </table>>];
    BESOIN [pos="4,-0.5!", label=<
      <table border="1" cellborder="0" cellspacing="0" cellpadding="4">
        <tr><td bgcolor="#dddddd"><b>BESOIN</b></td></tr>
        <tr><td align="left"><u>id_besoin</u><br align="left"/>nom<br align="left"/>prix<br align="left"/>quantite<br align="left"/></td></tr>
      </table>>];

    // Spécialisation de BESOIN (héritage du diagramme de classes)
    CONSOMMABLE [pos="1.5,-3.6!", label=<
      <table border="1" cellborder="0" cellspacing="0" cellpadding="4">
        <tr><td bgcolor="#dddddd"><b>CONSOMMABLE</b></td></tr>
        <tr><td align="left">perissable<br align="left"/></td></tr>
      </table>>];
    MATERIEL [pos="6.5,-3.6!", label=<
      <table border="1" cellborder="0" cellspacing="0" cellpadding="4">
        <tr><td bgcolor="#dddddd"><b>MATERIEL</b></td></tr>
        <tr><td align="left">a_rendre<br align="left"/>etat<br align="left"/></td></tr>
      </table>>];
    MATERIEL_SON [pos="4.5,-6.6!", label=<
      <table border="1" cellborder="0" cellspacing="0" cellpadding="4">
        <tr><td bgcolor="#dddddd"><b>MATERIEL_SON</b></td></tr>
        <tr><td align="left">decibels<br align="left"/>puissance_watts<br align="left"/></td></tr>
      </table>>];
    MATERIEL_LUMIERE [pos="8.5,-6.6!", label=<
      <table border="1" cellborder="0" cellspacing="0" cellpadding="4">
        <tr><td bgcolor="#dddddd"><b>MATERIEL_LUMIERE</b></td></tr>
        <tr><td align="left">lumens<br align="left"/>couleur<br align="left"/></td></tr>
      </table>>];

    // ---------------------------------------------------------------- associations
    node [shape=ellipse, style=filled, fillcolor="#f5f5f5"];
    ORGANISER [pos="4,5.3!",   label="ORGANISER"];
    INVITER   [pos="4,3.1!",   label="INVITER\nstatut\ndate_invitation"];
    ECRIRE    [pos="1,7!",     label="ECRIRE"];
    CONCERNER [pos="7,7!",     label="CONCERNER"];
    ACHETER   [pos="1,1.2!",   label="ACHETER"];
    CONTENIR  [pos="7,1.2!",   label="CONTENIR"];

    // ---------------------------------------------------------------- cardinalités
    PERSONNE  -- ORGANISER [label="0,n"];
    ORGANISER -- EVENEMENT [label="1,n"];

    PERSONNE  -- INVITER   [label="0,n"];
    INVITER   -- EVENEMENT [label="0,n"];

    PERSONNE  -- ECRIRE    [label="0,n"];
    ECRIRE    -- MESSAGE   [label="1,1"];
    EVENEMENT -- CONCERNER [label="0,n"];
    CONCERNER -- MESSAGE   [label="1,1"];

    PERSONNE  -- ACHETER   [label="0,n"];
    ACHETER   -- BESOIN    [label="0,1"];
    EVENEMENT -- CONTENIR  [label="0,n"];
    CONTENIR  -- BESOIN    [label="1,1"];

    // ---------------------------------------------------------------- héritage (flèche vers le parent)
    edge [dir=forward, arrowhead=empty, arrowsize=1.2];
    CONSOMMABLE      -- BESOIN;
    MATERIEL         -- BESOIN;
    MATERIEL_SON     -- MATERIEL;
    MATERIEL_LUMIERE -- MATERIEL;
}
